# ─── Database (Neon PostgreSQL) ─────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Better Auth ────────────────────────────────────────────
# Generate with: pnpm dlx @better-auth/cli generate (or `openssl rand -base64 32`)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── AI providers (PROMPT-OPS-05) ───────────────────────────
# Environment-backed secrets — never committed with real values, never
# stored in the database (the platform AI policy carries only these
# NAMES as references). A key change requires redeploy.
# OPENROUTER_API_KEY=
# AGENTROUTER_API_KEY=

# ─── Meta WhatsApp Cloud API (PROMPT-CORE-03B; Decision #42) ─
# Server-side secrets — optional until a Business connects a real
# WhatsApp number. Stored as env vars only (never in DB/UI/logs):
# - WHATSAPP_META_VERIFY_TOKEN: Meta webhook verify token (hub.verify_token)
# - WHATSAPP_META_APP_SECRET: Meta App Secret for X-Hub-Signature-256
# - WHATSAPP_META_ACCESS_TOKEN: fallback system access token (Bearer)
# - WHATSAPP_META_PHONE_NUMBER_ID: fallback Graph phone_number_id
# - WHATSAPP_META_API_VERSION: Graph version (e.g. v21.0; default v21.0)
# Per-connection overrides use WhatsAppConnection.credentialsRef (env-var NAME)
# and WhatsAppConnection.externalId (phone_number_id).
# WHATSAPP_META_VERIFY_TOKEN=
# WHATSAPP_META_APP_SECRET=
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_API_VERSION="v21.0"

# ─── Demo (optional) ────────────────────────────────────────
# Set to "true" to auto-seed the Arabic demo business (عيادة الابتسامة)
# every time you launch scripts/dev.sh (or dev.ps1 / dev-termux.sh).
# Requires a real DATABASE_URL. DEMO_MODE never runs in production builds.
# DEMO_MODE="true"
