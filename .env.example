# ─── Database (Neon PostgreSQL) ─────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Better Auth ────────────────────────────────────────────
# Generate with: pnpm dlx @better-auth/cli generate (or `openssl rand -base64 32`)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── AI providers (PROMPT-OPS-05) ───────────────────────────
# Environment-backed secrets — never committed with real values, never
# stored in the database (the platform AI policy carries only these
# NAMES as references). A key change requires redeploy.
# OPENROUTER_API_KEY=
# AGENTROUTER_API_KEY=
# ATRIA_API_KEY=
# CODECRAFT_API_KEY=

# ─── Meta WhatsApp Cloud API (PROMPT-CORE-03B; Decision #42) ─
# Server-side secrets — optional until a Business connects a real
# WhatsApp number. Stored as env vars only (never in DB/UI/logs):
# - WHATSAPP_META_VERIFY_TOKEN: Meta webhook verify token (hub.verify_token)
# - WHATSAPP_META_APP_SECRET: Meta App Secret for X-Hub-Signature-256
#   AND the future Embedded Signup server-side code exchange (client_secret)
# - WHATSAPP_META_APP_ID: Meta App ID for the Embedded Signup
#   adapter (non-secret id; operator-owned Meta App Dashboard value)
# - WHATSAPP_META_EMBEDDED_SIGNUP_CONFIG_ID: the Embedded Signup
#   `config_id` (non-secret configuration metadata created in the Meta
#   App Dashboard); required by the real adapter, server-side only
# - WHATSAPP_META_ACCESS_TOKEN: fallback system access token (Bearer)
# - WHATSAPP_META_PHONE_NUMBER_ID: fallback Graph phone_number_id
# - WHATSAPP_META_API_VERSION: Graph version (e.g. v21.0; default v21.0)
# Per-connection overrides use WhatsAppConnection.credentialsRef (env-var NAME)
# and WhatsAppConnection.externalId (phone_number_id).
# WHATSAPP_META_VERIFY_TOKEN=
# WHATSAPP_META_APP_SECRET=
# WHATSAPP_META_APP_ID=
# WHATSAPP_META_EMBEDDED_SIGNUP_CONFIG_ID=
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_API_VERSION="v21.0"

# ─── RUNTIME credential store (optional; Decision #49) ─────
# Master encryption key for RUNTIME credentials obtained at onboarding
# time (the `fp:<id>` reference grammar). 32 random bytes as HEX (64
# chars) or base64 (44 chars). Optional: while unset, the runtime
# credential store stays UNAVAILABLE (store/resolve of an `fp:<id>`
# reference fails closed) and the existing ENV grammar is unaffected.
# Server-side only — NEVER prefixed with NEXT_PUBLIC_, and NEVER stored
# in the database, logged, or returned by an API. Rotation is a later
# operational concern (the record's key_version is the hook).
# CREDENTIAL_MASTER_KEY=

# ─── Demo (optional) ────────────────────────────────────────
# Set to "true" to auto-seed the Arabic demo business (عيادة الابتسامة)
# every time you launch scripts/dev.sh (or dev.ps1 / dev-termux.sh).
# Requires a real DATABASE_URL. DEMO_MODE never runs in production builds.
# DEMO_MODE="true"
