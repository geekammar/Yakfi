{
  "name": "flowpilot",
  "version": "0.22.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup-env.mjs && pnpm install && pnpm db:generate && node scripts/install-git-hooks.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "security": "node scripts/security-check.mjs",
    "check:signup": "tsx scripts/check-signup-policy.ts",
    "check:policy": "tsx scripts/check-ai-policy.ts",
    "check:knowledge-visibility": "tsx scripts/check-ai-knowledge-visibility.ts",
    "check:ai-context-builder": "tsx scripts/check-ai-context-builder.ts",
    "check:ai-disclosure": "tsx scripts/check-ai-disclosure.ts",
    "check:eligibility": "tsx scripts/check-provider-eligibility.ts",
    "check:booking-options": "tsx scripts/check-booking-options.ts",
    "check:whatsapp-transport": "tsx scripts/check-whatsapp-transport.ts",
    "check:whatsapp-inbound": "tsx scripts/check-whatsapp-inbound.ts",
    "check:meta-whatsapp": "tsx scripts/check-meta-whatsapp.ts",
    "check:meta-embedded-signup": "tsx scripts/check-meta-embedded-signup.ts",
    "check:whatsapp-onboarding": "tsx scripts/check-whatsapp-onboarding.ts",
    "check:credentials-runtime": "tsx scripts/check-credentials-runtime.ts",
    "check:ai-prompts": "tsx scripts/generate-ai-prompts.ts --check && tsx scripts/check-ai-prompts.ts",
    "generate:ai-prompts": "tsx scripts/generate-ai-prompts.ts",
    "check:ai-provider": "tsx scripts/check-ai-provider.ts",
    "check:response-normalizer": "tsx scripts/check-response-normalizer.ts",
    "check:atria-retry": "tsx scripts/check-atria-retry.ts",
    "check:conversation-control": "tsx scripts/check-conversation-control.ts",
    "check:simulate-conversation-control": "tsx scripts/simulate-conversation-control.ts",
    "check:conversation-booking": "tsx scripts/check-conversation-booking.ts",
    "check:booking-confirm": "tsx scripts/check-booking-confirm.ts",
    "check:owner-invitation": "dotenv -e .env.local -e .env -- tsx scripts/check-owner-invitation.ts",
    "probe:atria": "dotenv -e .env.local -e .env -- tsx scripts/probe-atria.ts",
    "release": "bash scripts/release.sh",
    "ship": "node scripts/ship.mjs",
    "vercel:check": "node scripts/vercel-check.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/pre-deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:production": "node scripts/deploy.mjs prod",
    "deploy:vercel": "node scripts/deploy.mjs prod",
    "postinstall": "prisma generate",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "dev": "pnpm generate:ai-prompts && next dev",
    "build": "pnpm generate:ai-prompts && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "dotenv -e .env.local -e .env -- tsx prisma/seed.ts",
    "bootstrap:admin": "dotenv -e .env.local -e .env -- tsx scripts/bootstrap-production-admin.ts",
    "bootstrap:operator": "dotenv -e .env.local -e .env -- tsx scripts/bootstrap-platform-operator.ts",
    "icons": "node scripts/generate-pwa-icons.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-query-devtools": "^5.102.3",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "7.9.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.24.0"
}
