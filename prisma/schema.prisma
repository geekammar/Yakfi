// FlowPilot — Prisma schema
// Domain model (Spec A): onboarding, conversations, appointments,
// services, staff, customers.
// No founder features, billing, or payments.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
}

enum ConversationStatus {
  AI_ACTIVE
  NEED_HUMAN
  BOOKED
  INCOMPLETE
}

enum MessageSenderType {
  CUSTOMER
  AI
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

// ─── Core domain ─────────────────────────────────────────────

model Business {
  id                    String    @id @default(uuid())
  name                  String
  // Discovery metadata (operator PROMPT-07): the business's vertical as a
  // stable machine key validated by Zod (`VERTICALS` in lib/validation).
  // Metadata for Local Vertical Discovery ONLY — never permission for
  // vertical-specific UI (PRODUCT_VISION / DECISIONS #22 context).
  vertical              String?
  city                  String?
  whatsappNumber        String
  timezone              String    @default("Asia/Riyadh")
  about                 String?
  // Customer-facing location/address (PROMPT-AI-OPS-21). A single free-text
  // line — the smallest provider-neutral representation actually needed for
  // the assistant to answer "أين موقعكم؟". NOT geocoding, maps, routing, or
  // delivery zones; the owner is guided (placeholder) to include the
  // area/city naturally. CONDITIONAL in the B-01 policy: it reaches the
  // assistant ONLY on a contact/identity/location turn, and a missing
  // address is never invented. `city` stays a separate discovery-metadata
  // column (INTERNAL) — this is the customer-facing location fact.
  address               String?
  /// JSON working-hours structure, e.g. { "sun": { "open": "09:00", "close": "21:00", "closed": false }, ... }
  workingHours          Json?
  slotDurationMinutes   Int       @default(30) @map("slot_duration_minutes")
  // Booking confirmation mode (operator PROMPT-09): how new appointments
  // enter the agenda — "manual" (PENDING until the team confirms) or
  // "automatic" (CONFIRMED on creation). Stable machine key validated by
  // Zod (`CONFIRMATION_MODE_VALUES` in lib/validation) — no Prisma enum,
  // extending the list needs no migration. Default preserves the
  // pre-existing behavior (PENDING).
  confirmationMode      String    @default("manual") @map("confirmation_mode")
  /// JSON FAQ entries: [{ "question": "...", "answer": "..." }]
  faqs                  Json?
  cancellationPolicy    String?
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  // The Business's Default Branch (DECISIONS #30, PROMPT-ARCH-02): an
  // operational unit pointer — NOT the tenant boundary (businessId is).
  // Exactly one per Business, maintained structurally by the atomic
  // business-creation path (business + Default Branch + pointer in ONE
  // transaction) and the ARCH-02 backfill. Nullable only inside that
  // transaction; every existing Business row has it set.
  defaultBranchId String? @unique @map("default_branch_id")

  users                            User[]
  branches                         Branch[]
  defaultBranch                    Branch?                           @relation("DefaultBranch", fields: [defaultBranchId], references: [id], onDelete: Restrict)
  services                         Service[]
  customers                        Customer[]
  conversations                    Conversation[]
  appointments                     Appointment[]
  invitations                      Invitation[]
  whatsappConnections              WhatsAppConnection[]
  whatsappOnboardingAuthorizations WhatsAppOnboardingAuthorization[]
  telegramConnections              TelegramConnection[]
  telegramProvisioningLedgers      TelegramProvisioningLedger[]
  runtimeCredentials               RuntimeCredential[]
  providerProfiles                 ProviderProfile[]
  inboundDedupe                    InboundMessageDedupe[]
  usageRecords                     UsageRecord[]
  operatorAttentions               OperatorAttention[]
  knowledgeGaps                    KnowledgeGap[]

  @@index([isActive])
  @@map("businesses")
}

// ─── Branches (DECISIONS #30, PROMPT-ARCH-02) ────────────────
// Branch = an operational unit INSIDE the Business. The Business stays
// the tenant boundary (businessId); Branch is selective operational
// scoping only. Every Business has exactly one Default Branch (the
// Business.defaultBranchId pointer — no isDefault flag, no second
// source of truth). No Branch CRUD UI exists; the current UX remains
// effectively single-Branch (the Default Branch).

model Branch {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  name       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultForBusiness  Business?            @relation("DefaultBranch")
  conversations       Conversation[]
  appointments        Appointment[]
  whatsappConnections WhatsAppConnection[]
  telegramConnections TelegramConnection[]
  providerBranches    ProviderBranch[]

  @@index([businessId])
  @@map("branches")
}

model Service {
  id              String    @id @default(uuid())
  businessId      String    @map("business_id")
  name            String
  description     String?
  durationMinutes Int       @map("duration_minutes")
  isActive        Boolean   @default(true)
  // ── Service price (PROMPT-AI-ARCH-13 — Slice 6) ──────────────────────────
  // Authoritative, OPTIONAL, per-service DOMAIN price (NOT FlowPilot billing;
  // see ECONOMICS.md — the business's price TO ITS CUSTOMERS, never FlowPilot's
  // price to the business). STRUCTURED + MINIMAL, not a pricing engine: no
  // discounts / tax / coupons / dynamic rules / history. Name/duration remain
  // the only REQUIRED catalog facts; `durationMinutes` alone makes a service
  // bookable, price never does. Representation (all columns nullable; a null
  // `priceType` means NO price exists → the assistant must NEVER invent one):
  //   FIXED         → priceAmount                           (e.g. 300 EGP)
  //   RANGE         → priceAmount + priceMaxAmount           (e.g. 300–500 EGP)
  //   STARTING_FROM → priceAmount                            (e.g. "من 300")
  //   CONDITIONAL   → priceNote (bounded, e.g. "حسب الحالة") — amounts null
  // `priceType` is a stable machine key validated by the Zod union in
  // `lib/service-price` (NO Prisma enum — extending needs no migration, the
  // confirmationMode / vertical convention). `priceAmount`/`priceMaxAmount`
  // are whole currency units (sub-unit precision intentionally out of scope).
  // `priceCurrency` is an ISO machine key (validated union); it is present
  // whenever an amount is. Price is authoritative on the Service catalog and
  // is NEVER duplicated into the FAQ store (DECISIONS: no second price source).
  priceType       String?   @map("price_type")
  priceAmount     Int?      @map("price_amount")
  priceMaxAmount  Int?      @map("price_max_amount")
  priceCurrency   String?   @map("price_currency")
  priceNote       String?   @map("price_note")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  providerServices ProviderService[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@map("services")
}

model Customer {
  id                 String    @id @default(uuid())
  businessId         String    @map("business_id")
  name               String
  phone              String
  email              String?
  notes              String?
  lastConversationAt DateTime? @map("last_conversation_at")
  lastAppointmentAt  DateTime? @map("last_appointment_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  appointments  Appointment[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([phone])
  @@map("customers")
}

// ─── Conversations ───────────────────────────────────────────

model Conversation {
  id             String             @id @default(uuid())
  businessId     String             @map("business_id")
  customerId     String             @map("customer_id")
  // Branch-aware (DECISIONS #30): the operational unit this thread runs
  // in — always the Business's Default Branch today (single-Branch UX).
  // Resolved SERVER-side from the Business; never client input.
  branchId       String             @map("branch_id")
  assignedUserId String?            @map("assigned_user_id")
  status         ConversationStatus @default(AI_ACTIVE)
  lastMessageAt  DateTime?          @map("last_message_at")
  aiSummary      String?            @map("ai_summary")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedTo User?              @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages   Message[]
  attention  OperatorAttention?
  knowledgeGaps KnowledgeGap[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([branchId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid())
  conversationId String            @map("conversation_id")
  senderType     MessageSenderType @map("sender_type")
  content        String
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── Operator attention (PROMPT-B04) ────────────────────────
// The operator-facing notification layer on top of the EXISTING
// NEED_HUMAN / AI_HANDOFF handoff. NOT a second handoff concept: the
// handoff stays `ConversationStatus.NEED_HUMAN` (the authoritative,
// unchanged lifecycle). This row is the "the operator has not looked at
// this unresolved handoff yet" marker for ONE conversation.
//
// ONE row per conversation (`conversationId` is unique): opening
// attention on an already-open handoff refreshes the SAME row, and
// re-opening a resolved one resets it — structurally idempotent, so a
// message storm on a stuck thread can never spawn a notification storm.
// `resolvedAt IS NULL` means OPEN (unacknowledged); the operator
// acknowledging the thread (opening its detail screen) or the thread
// leaving NEED_HUMAN resolves it. Tenant isolation + cascade cleanup
// come from `businessId`. `reason` is a stable machine key (validated by
// the Zod union `attentionReasonValues`) — a COARSE operational category,
// never prompts, chain-of-thought, provider payload, or disclosure
// internals (see lib/validation/operator-attention).
model OperatorAttention {
  id             String    @id @default(uuid())
  businessId     String    @map("business_id")
  conversationId String    @unique @map("conversation_id")
  reason         String
  /**
   * The canonical TYPED handoff cause (PROMPT-AI-ARCH-16 — Slice 7) — the
   * stable, fine-grained "why does this need me?" value. ADDITIVE + NULLABLE:
   * legacy rows and staff-routed threads carry none; a missing value simply
   * falls back to the coarse `reason`. A stable machine key (no Prisma enum),
   * so extending the cause list needs no data migration.
   */
  cause          String?   @map("cause")
  createdAt      DateTime  @default(now()) @map("created_at")
  // Null while OPEN (the alert is live); set when the operator
  // acknowledges the thread or it leaves NEED_HUMAN.
  resolvedAt     DateTime? @map("resolved_at")
  resolvedById   String?   @map("resolved_by_id")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  resolvedBy   User?        @relation("AttentionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, resolvedAt])
  @@map("operator_attentions")
}

// ─── Knowledge gaps (PROMPT-AI-ARCH-18 — Slice 9) ───────────
// The RECORD-ONLY evidence that a turn ended in the authoritative
// `KNOWLEDGE_GAP_UNRESOLVED` handoff — "the assistant could not answer
// because authoritative knowledge was unresolved". It is NOT a second
// knowledge store, NOT RAG/embeddings, NOT an automatic learning artifact,
// and NOT a second operator system: it is a bounded, tenant-scoped,
// append-oriented row a human may review later. Recording is OFF the
// customer critical path (best-effort, after the reply was persisted +
// sent) and can NEVER alter a turn, fabricate knowledge, or promote
// anything. `category` and `status` are stable machine keys validated by
// Zod (no Prisma enum — extending the list needs no data migration).
// `status` is UNRESOLVED → REVIEWED / REJECTED; there is deliberately no
// APPROVED/PROMOTED state and no promotion write path — turning a gap
// into business knowledge is a future, explicitly human-approved workflow.
// `(conversationId, customerMessageId)` is unique per turn, so a crash
// replay of the same turn can never create a duplicate record.
model KnowledgeGap {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  conversationId    String    @map("conversation_id")
  customerMessageId String    @map("customer_message_id")
  category          String
  /** Bounded slice of the customer's own question (never model output). */
  subjectText       String?   @map("subject_text")
  status            String    @default("UNRESOLVED")
  createdAt         DateTime  @default(now()) @map("created_at")
  reviewedAt        DateTime? @map("reviewed_at")
  reviewedById      String?   @map("reviewed_by_id")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("KnowledgeGapReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([conversationId, customerMessageId])
  @@index([businessId, status])
  @@index([businessId, category, createdAt])
  @@map("knowledge_gaps")
}

// ─── Appointments ────────────────────────────────────────────

model Appointment {
  id             String            @id @default(uuid())
  businessId     String            @map("business_id")
  customerId     String            @map("customer_id")
  serviceId      String            @map("service_id")
  // Branch-aware (DECISIONS #30): always the Business's Default Branch
  // today; resolved SERVER-side, never client input.
  branchId       String            @map("branch_id")
  assignedUserId String?           @map("assigned_user_id")
  date           DateTime          @db.Date
  startTime      DateTime          @map("start_time") @db.Time
  endTime        DateTime          @map("end_time") @db.Time
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedTo User?    @relation("AppointmentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, date])
  @@index([branchId, date])
  @@index([status])
  @@index([customerId])
  @@index([serviceId])
  @@map("appointments")
}

// ─── WhatsApp connections (DECISIONS #31, PROMPT-ARCH-02) ────
// First-class, Business-owned WhatsApp identity with an OPTIONAL Branch
// scope and a provider-neutral external identity. The Business owns the
// number; a future Business-shared connection (branchId null) stays
// architecturally possible. `status` is a stable machine key validated
// by the Zod union `WHATSAPP_CONNECTION_STATUS_VALUES` — no Prisma
// enum, extending the list needs no migration (the confirmationMode /
// vertical pattern). SECRETS: `credentialsRef` stores a REFERENCE to a
// secret (env var name / secret-store pointer / encrypted-blob locator)
// — NEVER raw provider credentials.
//
// TWO SEPARATE LIFECYCLE SURFACES (WHATSAPP-ONBOARDING-01):
// 1. OPERATIONAL (`status` + `isActive`): the existing runtime gate
//    consumed by `resolveConnectionForSend` / `resolveInboundConnection`.
//    UNCHANGED in meaning and unchanged consumers.
// 2. ONBOARDING (`onboardingState` + `onboardingActor` + the reason/
//    timestamp fields below): a SEPARATE lifecycle that tracks the
//    Business Admin's Meta authorization → provisioning → readiness
//    flow. It is NEVER read by the transport runtime, the conversation
//    engine, booking, or AI. `READY` is written ONLY through
//    `markOnboardingReady`, which is guarded by the operational gate
//    (status CONNECTED + isActive) — so an onboarding-READY row is
//    always operationally usable, and the two surfaces can never drift
//    apart. The Meta provenance fields are non-secret REFERENCES only.

model WhatsAppConnection {
  id             String    @id @default(uuid())
  businessId     String    @map("business_id")
  branchId       String?   @map("branch_id")
  displayName    String?   @map("display_name")
  // The WhatsApp number itself (E.164). Unique per Business — a number
  // is one WhatsApp identity; migrating it between Businesses is a
  // deliberate future workflow, not a schema assumption.
  phoneNumber    String    @map("phone_number")
  // Provider-neutral external identity: provider machine key (e.g. a
  // future "meta_cloud") + the provider's own connection/WABA id. Both
  // nullable until a provider decision exists (DECISIONS #29).
  provider       String?
  externalId     String?   @map("external_id")
  status         String    @default("PENDING")
  credentialsRef String?   @map("credentials_ref")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // ── ONBOARDING LIFECYCLE (WHATSAPP-ONBOARDING-01) ──────────────
  // SEPARATE from the operational `status`/`isActive` gate above.
  // Stable machine keys validated by the Zod unions in
  // `lib/validation/whatsapp-connection` — no Prisma enum, extending
  // the list needs no migration. The DEFAULT keeps every existing row
  // honest: an pre-existing connection is NOT_STARTED (it never went
  // through the Meta authorization flow), never a false READY.
  onboardingState          String    @default("NOT_STARTED") @map("onboarding_state")
  onboardingActor          String    @default("NONE") @map("onboarding_actor")
  // LAST normalized failure only (see `onboardingFailureToView`):
  // stable internal code + safe human summary — never a raw provider
  // response, token, authorization code, or HTTP header.
  onboardingReasonCode     String?   @map("onboarding_reason_code")
  onboardingReasonSummary  String?   @map("onboarding_reason_summary")
  onboardingRetryable      Boolean?  @map("onboarding_retryable")
  onboardingStateChangedAt DateTime? @map("onboarding_state_changed_at")
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at")
  onboardingFailedAt       DateTime? @map("onboarding_failed_at")

  // ── CREDENTIAL REFERENCE KIND (WHATSAPP-ONBOARDING-01) ─────────
  // `credentialsRef` stays a REFERENCE; this records WHICH reference
  // grammar it uses. NULL on legacy rows = ENV (the existing behavior:
  // an environment-variable NAME). RUNTIME = an opaque `fp:<id>` handle
  // for a future runtime secret store (backend deferred).
  credentialKind String? @map("credential_kind")

  // ── META PROVENANCE (WHATSAPP-ONBOARDING-01) ───────────────────
  // Non-secret, provider-reported REFERENCE data written ONLY by the
  // onboarding callback. Provider-owned ids are provenance: they never
  // authorize anything and are never trusted as tenant identity
  // (`externalId` + server-derived Business scope stay authoritative).
  metaBusinessId     String? @map("meta_business_id")
  wabaId             String? @map("waba_id")
  displayPhoneNumber String? @map("display_phone_number")
  verifiedName       String? @map("verified_name")
  metaReviewStatus   String? @map("meta_review_status")

  business                 Business                          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                   Branch?                           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  onboardingAuthorizations WhatsAppOnboardingAuthorization[]

  @@unique([businessId, phoneNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([onboardingState])
  @@map("whatsapp_connections")
}

// ─── WhatsApp onboarding authorization ledger ───────────────
// (WHATSAPP-ONBOARDING-01; DECISIONS #23 check-then-act convention)
// ONE row per launched provider authorization attempt. The callback
// resolves the target Business + connection EXCLUSIVELY from this
// server-persisted state (`stateRef` is opaque, unguessable, and
// single-use) — never from a query parameter, a client payload, or the
// session. Replay protection: `consumedAt` is set exactly once by a
// conditional update, so a replayed callback is a deterministic
// rejection. Cross-tenant rejection: the row's connection is validated
// to belong to the row's Business before any write. Soft-delete is not
// needed (these are short-lived operational records; the Business
// cascade removes them).

model WhatsAppOnboardingAuthorization {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  connectionId String    @map("connection_id")
  // Opaque single-use state reference (the OAuth `state` surrogate).
  stateRef     String    @unique @map("state_ref")
  expiresAt    DateTime  @map("expires_at")
  // Set exactly once when the callback consumes this attempt.
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([connectionId])
  @@map("whatsapp_onboarding_authorizations")
}

// ─── Telegram second channel (DECISIONS #63/#64) ──────────────────────
// Telegram is a TRANSPORT SIBLING of WhatsApp, not a second product: it
// reuses the provider-neutral transport seams (MessageTransport /
// ConnectionVerifier / the normalized inbound envelope) and the same
// Conversation Engine. It is deliberately a SEPARATE entity — not a
// polymorphic `Connection` table and not a column on
// `WhatsAppConnection`: the WhatsApp identity is a required phone number
// with Meta-specific provenance, and generalizing either would be
// premature omnichannel infrastructure (forbidden by ARCHITECTURE.md).
// Two concrete siblings are the smaller, honest step.

model TelegramConnection {
  id            String    @id @default(uuid())
  businessId    String    @map("business_id")
  branchId      String?   @map("branch_id")
  displayName   String?   @map("display_name")
  // The managed bot's STABLE Telegram identity (the numeric bot id). The
  // authoritative provider key for this connection — inbound webhook
  // routing resolves this row server-side, never from a client payload.
  botExternalId String    @map("bot_external_id")
  // The bot's @username — a non-secret, provider-reported label.
  botUsername   String?   @map("bot_username")
  // Provider machine key: "telegram_managed" (the only approved
  // provisioning model — Telegram Managed Bots; the customer never pastes
  // a token and never visits BotFather; DECISIONS #63).
  provider      String    @default("telegram_managed")
  status        String    @default("PENDING")
  // REFERENCE to the managed bot's token — an opaque `fp:<id>` RUNTIME
  // handle (DECISIONS #49) resolved ONLY inside the Telegram adapter.
  // NEVER the raw token, never an ENV name: managed-bot tokens are
  // obtained at provisioning time and must not require a redeploy.
  credentialsRef String?  @map("credentials_ref")
  credentialKind String?  @map("credential_kind")
  // SHA-256 hex digest of the per-connection webhook `secret_token`
  // (DECISIONS #63 (E)). A NON-SECRET, non-reversible INDEX: inbound
  // webhook routing looks the connection up by the digest of the
  // `X-Telegram-Bot-Api-Secret-Token` header. The plaintext secret is
  // generated at provisioning, handed to Telegram ONCE via `setWebhook`,
  // and NEVER persisted anywhere.
  webhookSecretHash String? @unique @map("webhook_secret_hash")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // ── ONBOARDING LIFECYCLE ────────────────────────────────────────
  // SEPARATE from the operational `status`/`isActive` gate above, exactly
  // like `WhatsAppConnection`. Stable machine keys validated by the Zod
  // unions in `lib/validation/telegram-connection` — no Prisma enum, so
  // extending the list needs no migration. The DEFAULT keeps every row
  // honest: a connection that never completed provisioning is
  // NOT_STARTED, never a false READY.
  onboardingState          String    @default("NOT_STARTED") @map("onboarding_state")
  onboardingActor          String    @default("NONE") @map("onboarding_actor")
  // LAST normalized failure only: stable internal code + safe human
  // summary — never a raw provider response, token, or HTTP header.
  onboardingReasonCode     String?   @map("onboarding_reason_code")
  onboardingReasonSummary  String?   @map("onboarding_reason_summary")
  onboardingRetryable      Boolean?  @map("onboarding_retryable")
  onboardingStateChangedAt DateTime? @map("onboarding_state_changed_at")
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at")
  onboardingFailedAt       DateTime? @map("onboarding_failed_at")

  // ── TELEGRAM PROVENANCE (DECISIONS #63 (D)) ─────────────────────
  // The FlowPilot Manager Bot that provisioned this bot — operator-level
  // and non-secret. Retained so a `ManagedBotUpdated` owner/token event
  // can be correlated to its provisioning bot.
  managerBotId          String? @map("manager_bot_id")
  // The Telegram `user.id` that created this managed bot (the Admin who
  // confirmed creation in Telegram's native UI). Single-use-bound to the
  // provisioning ledger row: a forged provisioning callback cannot claim
  // another Business because the `managed_bot` creator `user.id` must
  // equal the ledger's bound creator. Telegram fires `ManagedBotUpdated`
  // on an owner change; a mismatch vs this bound creator is a SECURITY
  // EVENT (→ DISCONNECTED / ACTION_REQUIRED, never silent trust).
  creatorTelegramUserId String? @map("creator_telegram_user_id")

  business             Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch               Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  provisioningLedgers  TelegramProvisioningLedger[]

  @@unique([businessId, botExternalId])
  @@index([businessId])
  @@index([branchId])
  @@index([onboardingState])
  @@map("telegram_connections")
}

// ─── Telegram provisioning ledger (DECISIONS #63 (D)) ─────────────────
// The single-use provisioning ledger — the exact analogue of
// `WhatsAppOnboardingAuthorization` for the managed-bot path. One row per
// LAUNCHED provisioning attempt; the deep-link `start` payload carries
// ONLY the opaque `startToken`, and the target Business + bound creator
// are resolved from THIS server-persisted row — never from a client
// payload, a query parameter, or the webhook body.

model TelegramProvisioningLedger {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  // Set once the `managed_bot` event creates the connection row (the bot
  // id is unknown before Telegram delivers that event) — provenance only.
  connectionId String?   @map("connection_id")
  // Opaque single-use start token (the deep-link `?start=<token>` value).
  // The ONLY thing the customer-facing link carries; unguessable, and the
  // raw token is stored ONLY here as a unique lookup key.
  startToken   String    @unique @map("start_token")
  // The Telegram `user.id` that opened the deep link and STARTed the
  // Manager Bot — bound at that moment. The later `managed_bot` event's
  // creator `user.id` MUST equal this value, or the callback matches no
  // row and nothing is provisioned (cross-tenant forgery protection).
  creatorTelegramUserId String? @map("creator_telegram_user_id")
  expiresAt    DateTime  @map("expires_at")
  // TERMINAL marker: set exactly once when this attempt leaves the
  // in-flight state — either by a successful `managed_bot` completion
  // (`outcomeCode = "PROVISIONED"` + `connectionId` set) or by a
  // normalized provisioning failure (`outcomeCode` = the typed failure
  // code, `connectionId` stays null). While null the attempt is in
  // flight and the UI's honest state is "waiting on the Admin's Telegram
  // confirmation". A null `consumedAt` with a past `expiresAt` is an
  // abandoned attempt (the Admin never confirmed) — the UI surfaces that
  // as an actionable, retryable state, never a permanent spinner.
  consumedAt   DateTime? @map("consumed_at")
  // The typed OUTCOME of this attempt once terminal (machine key from the
  // provisioning boundary's result taxonomy; null while in flight). The
  // ONLY failure signal the pre-connection phase has — there is no
  // `TelegramConnection` row to carry an onboarding failure until the bot
  // id is known, so the honest reason lives HERE. The feature layer maps
  // it to a safe Arabic summary + a retryable flag; a raw provider
  // response never reaches this column or the UI.
  outcomeCode  String?   @map("outcome_code")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connection  TelegramConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([connectionId])
  @@map("telegram_provisioning_ledgers")
}

// ─── Runtime credentials (WHATSAPP-ONBOARDING-01; DECISIONS #49) ──
// The server-side RUNTIME secret backend for the `fp:<id>` reference
// grammar. A dedicated record — the ciphertext never sits on
// `WhatsAppConnection` (tenant/credential lifecycle stays clean: this
// row is created when a credential is obtained at runtime and removed by
// the Business cascade).
//
// The opaque `credentialsRef` is BOTH the stable indirection the rest of
// the system sees (`WhatsAppConnection.credentialsRef`) AND this table's
// unique key. It is derived from the reference only — never from a phone
// number, business name, email, Meta Business ID, WABA ID, or
// phone_number_id — and it never contains the secret it points at.
//
// THIS TABLE HOLDS ONLY ENCRYPTED MATERIAL + SAFE METADATA. The raw
// credential is encrypted application-side (AES-256-GCM, unique IV per
// credential, auth tag preserved, versioned blob) BEFORE any write; the
// master encryption key lives ONLY in the server environment
// (`CREDENTIAL_MASTER_KEY`) — never in this table, never in a log, never
// in a projection. Prisma query logs therefore can only ever contain
// ciphertext. Master-key rotation is a later operational concern.

model RuntimeCredential {
  id             String   @id @default(uuid())
  // The opaque `fp:<id>` handle — unique, unguessable, the ONLY thing the
  // feature/adapter layer ever persists on a connection.
  credentialsRef String   @unique @map("credentials_ref")
  businessId     String   @map("business_id")
  // Versioned AES-256-GCM package: `v1:` + base64(iv || ciphertext || authTag).
  cipherBlob     String   @map("cipher_blob")
  // Safe metadata (never the key, never the plaintext).
  algorithm      String   @default("AES-256-GCM")
  keyVersion     Int      @default(1) @map("key_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("runtime_credentials")
}

// ─── Providers (DECISIONS #32, PROMPT-ARCH-02) ───────────────
// A Provider is a bookable professional identity — NOT an authorization
// role (roles stay ADMIN/STAFF only). ProviderProfile is minimal and
// optional: attached to a User, owned by the Business. ProviderService
// and ProviderBranch are lightweight eligibility relations. One
// Appointment carries at most one Provider (the existing
// assignedUserId seam — unchanged in this pass).

model ProviderProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  businessId  String   @map("business_id")
  displayName String?  @map("display_name")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services ProviderService[]
  branches ProviderBranch[]

  @@index([businessId])
  @@map("provider_profiles")
}

model ProviderService {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  serviceId  String   @map("service_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@index([serviceId])
  @@map("provider_services")
}

model ProviderBranch {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  branchId   String   @map("branch_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([providerId, branchId])
  @@index([branchId])
  @@map("provider_branches")
}

// ─── Inbound webhook idempotency (DECISIONS #34, PROMPT-ARCH-02) ──
// Durable dedupe ledger for the provider-neutral inbound boundary: ONE
// row per (business, external message key). The external key is the
// transport's message id when provided, else a deterministic SHA-256 of
// the canonical payload — provider-neutral, tenant-safe. The row is
// claimed before processing and its conversationId/customerMessageId
// are recorded in the SAME transaction as the customer message insert,
// so "row has a message id" ⟺ "message row exists" — a retried webhook
// can never duplicate a persisted message, and a crashed attempt never
// strands the key. Ids are plain references (no FKs) on purpose: they
// are provenance records, and hard deletes cascade from the Business
// anyway.

model InboundMessageDedupe {
  id                String   @id @default(uuid())
  businessId        String   @map("business_id")
  externalKey       String   @map("external_key")
  conversationId    String?  @map("conversation_id")
  customerMessageId String?  @map("customer_message_id")
  claimedAt         DateTime @default(now()) @map("claimed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, externalKey])
  @@index([businessId])
  @@map("inbound_message_dedupe")
}

// ─── Usage telemetry (DECISIONS #36, PROMPT-ARCH-02) ─────────
// Append-only RAW USAGE FACTS ONLY — no pricing, no billing, no
// entitlements (Usage ≠ Cost ≠ Price ≠ Entitlement ≠ Billing; see
// ECONOMICS.md). `kind` is a stable machine key validated by the Zod
// union `USAGE_KIND_VALUES`; `status` by `USAGE_STATUS_VALUES`.
// Token counts + provider/model identifiers are stored so any future
// cost model can be computed RETROACTIVELY without rewriting history;
// `estimatedCostMicros` is an optional point-in-time snapshot (micro
// units of the provider's billing currency) — never computed by this
// codebase yet. NO message content, NO secrets, NO chain-of-thought —
// only ids and counters. Deletes happen solely via the Business cascade.

model UsageRecord {
  id                   String   @id @default(uuid())
  businessId           String   @map("business_id")
  kind                 String
  conversationId       String?  @map("conversation_id")
  messageId            String?  @map("message_id")
  whatsappConnectionId String?  @map("whatsapp_connection_id")
  provider             String?
  model                String?
  inputTokens          Int?     @map("input_tokens")
  outputTokens         Int?     @map("output_tokens")
  estimatedCostMicros  Int?     @map("estimated_cost_micros")
  status               String
  occurredAt           DateTime @map("occurred_at")
  createdAt            DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, occurredAt])
  @@index([businessId, kind, occurredAt])
  @@index([conversationId])
  @@map("usage_records")
}

// ─── Invitations ─────────────────────────────────────────────
// FlowPilot domain concept (DECISIONS #22): an email invited to join
// one Business with a Business role. NOT a Better Auth record and NOT
// a replacement for it. Only the token HASH is stored — raw tokens are
// never persisted. Lifecycle is derived from timestamps (no status
// enum, no deletedAt): pending = acceptedAt/revokedAt null + unexpired;
// accepted = acceptedAt set; revoked = revokedAt set; expired = pending
// + expiresAt in the past. activatedAt marks completed account
// activation (set exactly once by the activation workflow; a set value
// means the invited identity was created and the Business membership
// attached — one-time guarantee).

model Invitation {
  id          String    @id @default(uuid())
  email       String
  businessId  String    @map("business_id")
  role        UserRole
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  // Completed account activation (PROMPT-05): null until the invited
  // identity exists and the Business membership is attached.
  activatedAt DateTime? @map("activated_at")
  // Nullable: until the Platform Operator identity exists, a required
  // relation would block future platform-level provisioning.
  invitedById String?   @map("invited_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, email])
  @@map("invitations")
}

// ─── Platform Control Plane (PROMPT-OPS-05) ──────────────────
// Owner invitations are PLATFORM-scoped and PRE-Business: the Business
// does not exist yet — it is created by the canonical onboarding wizard
// after the owner activates a credential. Only the token HASH is stored
// (same security utility as business invitations; raw tokens are never
// persisted). Lifecycle is derived from timestamps (no status enum):
// pending = acceptedAt/activatedAt null + unexpired; accepted =
// acceptedAt set; activated = activatedAt set (credential created, role
// ADMIN attached, businessId still null until onboarding); expired =
// pending + past expiry. Duplicate-open invitations are prevented per
// email at the workflow layer (transaction-scoped check-then-create,
// DECISIONS #23 semantics — the same email may be re-invited after
// expiry/acceptance, so no DB unique constraint on email).

model PlatformInvitation {
  id           String    @id @default(uuid())
  email        String
  // Operator-facing memo (which business the invitation was created
  // for) — display-only, never authorization.
  businessName String?   @map("business_name")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  // Completed credential activation (PROMPT-OPS-05): set exactly once
  // by the activation workflow — identity exists + role ADMIN.
  activatedAt  DateTime? @map("activated_at")
  // Nullable: the Platform Operator identity may not exist yet.
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  createdBy User? @relation("PlatformInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdById])
  @@map("platform_invitations")
}

// ─── Platform AI Policy (PROMPT-OPS-05) ──────────────────────
// ONE platform-scoped, DB-backed configuration row (runtime-readable,
// no deployment needed for policy changes). Provider/model identity +
// fallback policy + secret REFERENCE names only — NEVER API keys (keys
// stay environment-backed: OPENROUTER_API_KEY / AGENTROUTER_API_KEY).
// The singleton is structurally enforced: the fixed 'singleton' primary
// key — a second insert fails on the PK conflict, so there is always
// exactly ONE effective policy row. Provider identities are validated
// by the Zod union `aiProviderValues` (lib/validation/platform) — no
// Prisma enum, extending the list needs no migration. ConversationAi
// keeps depending on its abstraction — this row is configuration, not
// integration.

model PlatformAiPolicy {
  id                 String   @id @default("singleton")
  primaryProvider    String   @map("primary_provider")
  primaryModel       String   @map("primary_model")
  secondaryProvider  String?  @map("secondary_provider")
  secondaryModel     String?  @map("secondary_model")
  fallbackEnabled    Boolean  @default(true) @map("fallback_enabled")
  primarySecretRef   String   @map("primary_secret_ref")
  secondarySecretRef String?  @map("secondary_secret_ref")
  // Audit reference — the Platform Operator who last changed the policy.
  updatedById        String?  @map("updated_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  updatedBy User? @relation("PlatformAiPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_ai_policies")
}

// ─── Users & auth ────────────────────────────────────────────
// The Better Auth required fields stay untouched; domain fields
// (business, role) extend the same `users` table.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @map("email_verified")
  image         String?
  // FlowPilot domain fields
  businessId    String?  @map("business_id")
  role          UserRole @default(STAFF)
  isActive      Boolean  @default(true)
  // Account scope (DECISIONS #22, PROMPT-ARCH-02): explicit platform-level
  // authorization marker — "BUSINESS" (default; every account the
  // invitation-first flows create) or "PLATFORM" (Platform Operator).
  // Platform access is NEVER inferred from businessId = null; the marker
  // is server-managed (Better Auth input:false) and unreachable from any
  // client input. NOT a role: business roles stay ADMIN/STAFF only.
  accountType   String   @default("BUSINESS") @map("account_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  business                   Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)
  sessions                   Session[]
  accounts                   Account[]
  providerProfile            ProviderProfile?
  assignedConversations      Conversation[]       @relation("ConversationAssignee")
  assignedAppointments       Appointment[]        @relation("AppointmentAssignee")
  invitationsCreated         Invitation[]         @relation("InvitationCreator")
  platformInvitationsCreated PlatformInvitation[] @relation("PlatformInvitationCreator")
  aiPolicyUpdates            PlatformAiPolicy[]   @relation("PlatformAiPolicyUpdater")
  resolvedAttentions         OperatorAttention[]  @relation("AttentionResolver")
  reviewedKnowledgeGaps      KnowledgeGap[]       @relation("KnowledgeGapReviewer")

  @@index([businessId])
  @@index([accountType])
  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  // Better Auth core field (v1.7): sign-up writes the synthetic issuer
  // ("local:credential" for local accounts) and sign-in matches the
  // credential account by it. Required by the installed version's
  // credential-account lookup — without it every credential flow fails.
  issuer                String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
